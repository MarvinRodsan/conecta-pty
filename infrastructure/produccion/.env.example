# Copia este archivo como .env (en esta misma carpeta, en el servidor) y cambia los valores.
# .env NUNCA se sube a GitHub (está en .gitignore). Permisos recomendados: chmod 600 .env
# Genera contraseñas fuertes en el servidor con:  openssl rand -base64 32 | tr -d '/+='

# Dominio que apunta (registro A) a la IP del servidor
DOMINIO=api.tu-dominio.com
# Correo para avisos de Let's Encrypt (vencimiento de certificados)
CORREO_ACME=tu-correo@ejemplo.com

# Dueño del esquema (migraciones y respaldos)
DB_ADMIN_PASSWORD=cambia-esto
# Usuario de la app (solo leer/escribir filas). Debe ser distinta de la de arriba.
DB_APP_PASSWORD=cambia-esto-tambien

# false apaga la búsqueda de direcciones (Photon) si hay problemas con el servicio externo
GEOCODER_HABILITADO=true
